---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
			<span class="brand-copy">
				<strong>KICKOUT</strong>
				<small>WRESTLING STORIES</small>
			</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Stories</HeaderLink>
		</div>
		<p class="header-note">THE ART OF THE NEAR FALL<br /><span>Every count tells a story.</span></p>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: #211f1d;
		border-bottom: 4px solid #a63720;
		box-shadow: 0 8px 24px rgba(34, 29, 24, 0.16);
	}
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 2em;
		width: min(1120px, 100%);
		min-height: 88px;
		margin: 0 auto;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.8em;
		width: fit-content;
		color: #f7f2e8;
		text-decoration: none;
	}
	.brand-mark {
		display: flex;
		align-items: end;
		gap: 3px;
		height: 34px;
		padding: 5px;
		border: 1px solid #9c9588;
		border-radius: 3px;
		transform: skew(-8deg);
	}
	.brand-mark span {
		width: 4px;
		height: 9px;
		background: #e6dfd2;
	}
	.brand-mark span:nth-child(2) {
		height: 16px;
	}
	.brand-mark span:nth-child(3) {
		height: 23px;
		background: #d28356;
	}
	.brand-copy {
		display: flex;
		flex-direction: column;
		line-height: 1;
	}
	.brand-copy strong {
		font-family: 'Oswald', sans-serif;
		font-size: 1.45rem;
		letter-spacing: 0.09em;
	}
	.brand-copy small {
		margin-top: 0.45em;
		color: #c8c0b3;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.6em;
	}
	.internal-links :global(a) {
		padding: 0.5em 0.8em;
		border: 1px solid transparent;
		border-radius: 3px;
		color: #f7f2e8;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}
	.internal-links :global(a:hover),
	.internal-links :global(a:focus-visible) {
		border-color: #8c857b;
		outline: none;
	}
	.internal-links :global(a.active) {
		border-color: #d28356;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}
	.header-note {
		justify-self: end;
		margin: 0;
		color: #f7f2e8;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		line-height: 1.6;
		text-align: right;
	}
	.header-note span {
		color: #c8c0b3;
		font-size: 0.9em;
		font-weight: 400;
		letter-spacing: 0.02em;
	}
	@media (max-width: 720px) {
		header {
			padding: 0 1em;
		}
		nav {
			grid-template-columns: 1fr auto;
			min-height: 74px;
			gap: 0.75em;
		}
		.header-note {
			display: none;
		}
	}
	@media (max-width: 420px) {
		.brand-copy strong {
			font-size: 1.15rem;
		}
		.brand-copy small {
			font-size: 0.52rem;
		}
		.internal-links {
			gap: 0;
		}
		.internal-links :global(a) {
			padding: 0.45em;
		}
	}
</style>
