---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<span>&copy; {today.getFullYear()} {SITE_TITLE}</span>
	<span class="footer-note">Stories from the squared circle.</span>
</footer>
<style>
	footer {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		padding: 1.5em max(1em, calc((100% - 1120px) / 2));
		background: #211f1d;
		border-top: 4px solid #a63720;
		color: #f7f2e8;
		font-size: 0.9rem;
	}
	.footer-note {
		color: #c8c0b3;
	}
	@media (max-width: 480px) {
		footer {
			flex-direction: column;
			gap: 0.25em;
		}
	}
</style>
